# ==========================================
# PROMETHEUS DISCORD BOT - ENVIRONMENT CONFIG
# ==========================================

# Discord Bot Token (From Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=your_discord_bot_token_here

# Google Gemini API Key (For AI Chat, TL;DR, and /imagine features)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Discord Application Client ID & Guild ID (Optional for global, Recommended for instant sync)
CLIENT_ID=1532437892318892144
GUILD_ID=1508741457769664573

# Server Port for REST API & Telemetry
PORT=3000

# PostgreSQL Database Connection (Optional - falls back to memory mode if omitted)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=prometheus_bot
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secure_password

# Environment Mode
NODE_ENV=production
